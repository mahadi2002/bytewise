# Secrets — never commit
.env
.env.*.local

# Local runtime data — logs contain real (test) mobile numbers/OTP codes,
# mock_executions is scratch output from the mock code-execution gateway
storage/logs/*
!storage/logs/.gitkeep
storage/mock_executions/*
!storage/mock_executions/.gitkeep

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Vite build tooling — reproducible via `npm install`. public/assets/dist/
# (the actual build OUTPUT) is intentionally NOT ignored: it's committed so
# a plain deploy never needs npm install (see package.json).
node_modules/
