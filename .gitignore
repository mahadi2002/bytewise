.env
.env.*.local

# Local runtime data — logs contain real (test) mobile numbers/OTP codes,
# mock_executions is scratch output from the mock code-execution gateway
storage/logs/*
!storage/logs/.gitkeep
storage/mock_executions/*
!storage/mock_executions/.gitkeep

