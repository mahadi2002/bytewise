APP_ENV=local                 # local | staging | production
APP_KEY=                      # 32-byte random, base64 — AES-256-GCM. Generate: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
HASH_PEPPER=                  # SEPARATE 32-byte random secret — blind-index HMAC key, never equal to APP_KEY
APP_URL=http://127.0.0.1:8040
APP_TIMEZONE=Asia/Dhaka

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bytewise
DB_USERNAME=bytewise_app       # low-privilege runtime user, see database/migrate.php / DDL-denial probe
DB_PASSWORD=

DB_MIGRATE_USERNAME=bytewise_migrate  # separate admin credential, migrations only, never used at runtime
DB_MIGRATE_PASSWORD=

SESSION_COOKIE_NAME=bytewise_session
SESSION_LIFETIME_MINUTES=120
SESSION_SECURE_COOKIE=true     # false only under APP_ENV=local over plain HTTP

SUBSCRIPTION_GATEWAY=mock      # mock | carrier
CARRIER_GATEWAY_BASE_URL=      # left blank until real BDApps/SDP credentials exist — BLOCKER-1
CARRIER_GATEWAY_API_KEY=
CARRIER_GATEWAY_MERCHANT_ID=

EXECUTION_GATEWAY=mock         # mock | remote_judge
REMOTE_JUDGE_BASE_URL=         # self-hosted Judge0/Piston instance's URL — BLOCKER-2
REMOTE_JUDGE_API_KEY=
REMOTE_JUDGE_TIMEOUT_SECONDS=10

OTP_BYPASS_CODE=123456         # ONLY read when APP_ENV=local — guard lives in OtpService, not the gateway

TRUSTED_PROXIES=

RATE_LIMIT_OTP_REQUEST_PER_HOUR=3
RATE_LIMIT_OTP_REQUEST_PER_DAY=8
RATE_LIMIT_OTP_VERIFY_PER_15MIN=5
RATE_LIMIT_OTP_RESEND_COOLDOWN_SECONDS=60
RATE_LIMIT_ADMIN_LOGIN_PER_15MIN=5
RATE_LIMIT_CONTACT_FORM_PER_HOUR=3
RATE_LIMIT_CODE_SUBMIT_PER_HOUR=20
RATE_LIMIT_CODE_SUBMIT_PER_DAY=100
RATE_LIMIT_DISCUSSION_POST_PER_HOUR=10
